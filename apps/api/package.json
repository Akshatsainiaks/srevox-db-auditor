{
  "name": "srevox-db-auditor-api",
  "version": "0.0.2",
  "description": "Srevox main API — Node.js + Fastify + PostgreSQL + Redis",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --format=esm --packages=external",
    "start": "node dist/index.js",
    "bump-version": "node ../../scripts/bump-version.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^8.3.1",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "mysql2": "^3.24.5",
    "nodemailer": "^8.0.7",
    "postgres": "^3.4.4",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
