# ═══════════════════════════════════════════════════════
#  Srevox DB Auditor — Self-Hosted Configuration
#  Copy this file to .env and fill in the values below
#  Everything else is pre-configured automatically
# ═══════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────
POSTGRES_PASSWORD=your_secure_password_here
BACKEND_SECRET_KEY=any_random_32_character_string_here
ENCRYPTION_KEY=exactly_32_characters_here_____

# ── Redirection & Alerts ──────────────────────────────
# The URL of the frontend dashboard (required for Teams/Slack/Email alert buttons)
FRONTEND_URL=http://localhost:7005

# ── Optional Port Overrides ───────────────────────────
# FRONTEND_PORT=7005
# API_PORT=7001
# ACTIVITY_PORT=7002
# POSTGRES_PORT=7432
# REDIS_PORT=6379
# CLICKHOUSE_PORT=8123

# ── Email Alerts (optional) ───────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@company.com
# SMTP_PASS=your_app_password
