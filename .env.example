# ═══════════════════════════════════════════════════════════════
#  Srevox DB Auditor — Self-Hosted Environment Configuration
#  Copy this file to .env and adjust values if needed.
# ═══════════════════════════════════════════════════════════════

# ── General Version ──────────────────────────────────────────
SREVOX_VERSION=v0.0.1

# ── Secrets & Encryption Keys ─────────────────────────────────
# Any random 32-character string used to sign JWT session tokens
BACKEND_SECRET_KEY=srevox_audit_jwt_secret_key_32_chars_min
# Exactly 32 characters for AES-256-GCM database credential encryption
ENCRYPTION_KEY=srevox_audit_aes256_enc_key_32c

# ── Service Ports ─────────────────────────────────────────────
API_PORT=7001
FRONTEND_PORT=7005
POSTGRES_PORT=7432
REDIS_PORT=7379
ACTIVITY_PORT=7002

# ── URLs & Endpoints ──────────────────────────────────────────
FRONTEND_URL=http://localhost:7005
API_URL=http://localhost:7001
ACTIVITY_SERVICE_URL=http://localhost:7002

# ── Internal PostgreSQL Database ──────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=srevoxdbauditor
POSTGRES_USER=srevox
POSTGRES_PASSWORD=srevoxdbauditor

# ── Internal Redis Cache & PubSub ─────────────────────────────
REDIS_URL=redis://redis:6379

# ── ClickHouse Analytics (optional for high-throughput CDC) ───
CLICKHOUSE_URL=http://clickhouse:8123

# ── Alert Notification Channels (optional SMTP fallback) ──────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@company.com
# SMTP_PASS=your_app_password
